# ---- LLM (Anthropic) --------------------------------------------------------
# Used to parse free-text requests and provider WhatsApp messages / scanned PDFs.
# Without it the system falls back to regex-only parsing (works, less flexible).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# ---- WhatsApp Cloud API (Meta) ---------------------------------------------
# From Meta for Developers > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-secret-string
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v22.0
# Comma-separated phone numbers (digits only, with country code) allowed to use the bot.
WHATSAPP_ALLOWED_NUMBERS=

# ---- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Cotizaciones <cotizaciones@example.com>"
# If set, every outgoing email is sent here instead of the customer (safe testing).
EMAIL_REDIRECT_TO=

# ---- Google Drive (service account) ----------------------------------------
# Path to the service-account JSON key, or paste the JSON itself in GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# Drive folder shared with the service account (the ID at the end of the folder URL).
GOOGLE_DRIVE_FOLDER_ID=

# ---- Fotos (opcional): búsqueda de imágenes en Google Custom Search (100 consultas/día gratis) ----
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# ---- Storage ----------------------------------------------------------------
# Postgres (Supabase). When empty, a local JSON file store is used (./data/store.json).
DATABASE_URL=
# Secret for calling /api/ingest/refresh (cron) manually or from a scheduler.
CRON_SECRET=
