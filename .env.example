# ---- LLM (Anthropic) --------------------------------------------------------
# Used to parse free-text requests and provider WhatsApp messages / scanned PDFs.
# Without it the system falls back to regex-only parsing (works, less flexible).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# ---- WhatsApp Cloud API (Meta) ---------------------------------------------
# From Meta for Developers > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-secret-string
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v22.0
# Comma-separated phone numbers (digits only, with country code) allowed to use the bot.
WHATSAPP_ALLOWED_NUMBERS=
# Administrators (digits only, comma-separated, e.g. 18605180534): only they can register a new provider from
# WhatsApp ("proveedor nuevo: NOMBRE") or delete one ("borrar proveedor NOMBRE"). Empty = nobody can; price lists
# of unknown providers are then refused (the CLI `npm run ingest` still loads anything).
ADMIN_NUMBERS=

# ---- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Cotizaciones <cotizaciones@example.com>"
# If set, every outgoing email is sent here instead of the customer (safe testing).
EMAIL_REDIRECT_TO=

# ---- Google Drive (service account) ----------------------------------------
# Path to the service-account JSON key, or paste the JSON itself in GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# Drive folder shared with the service account (the ID at the end of the folder URL).
GOOGLE_DRIVE_FOLDER_ID=

# ---- Fotos (opcional): búsqueda de imágenes en Google Custom Search (100 consultas/día gratis) ----
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# ---- Storage ----------------------------------------------------------------
# Postgres (Supabase). When empty, a local JSON file store is used (./data/store.json).
DATABASE_URL=
# Secret for calling /api/ingest/refresh (cron) manually or from a scheduler.
# También protege el cron diario del portal (/api/cron/daily, vercel.json): Vercel manda "Authorization: Bearer $CRON_SECRET".
# Sin él, /api/cron/daily responde 500.
CRON_SECRET=
# Biblioteca de fotos (npm run photos): otro Chrome/Chromium para webs detrás de Cloudflare (por defecto, el Google Chrome instalado)
# PHOTOS_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ---- Portal comercial (/portal) ---------------------------------------------
# Secreto para firmar los enlaces de acceso que manda el bot (comando *portal*) y las sesiones. Obligatorio para el portal;
# genera uno con: openssl rand -base64 32
PORTAL_SESSION_SECRET=
# URL pública del portal para los enlaces (sin "/" final). Vacío: https://$VERCEL_PROJECT_PRODUCTION_URL o http://localhost:3000
PORTAL_BASE_URL=
# Números (solo dígitos, con código de país) que la siembra de usuarios registra como supervisor (Juan Bustios) y admin (Tony).
PORTAL_SUPERVISOR_NUMBER=
PORTAL_ADMIN_NUMBER=
# Jefe del Dpto. Técnico (Ing. Danyer Saavedra): "cita ... con danyer" le avisa por WhatsApp y la siembra lo registra como
# tecnico. Vacío: el bot le dice al vendedor que avise él.
PORTAL_TECH_LEAD_NUMBER=
# Encuesta de satisfacción: invitación automática en el cron diario. Apagada por defecto; "1" o "true" la enciende
# (si no, el cron solo informa cuántas empresas se encuestarían). Correo solo con RESEND_API_KEY y un EMAIL_FROM verificado.
SURVEY_AUTO=
# Proveedor de buró de crédito: manual (por defecto; se adjunta el PDF en la ficha) o equifax (esqueleto: "no configurado").
CREDIT_BUREAU_PROVIDER=manual
