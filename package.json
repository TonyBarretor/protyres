{
  "name": "protyres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tyre quoting bot pilot: provider price lists (Excel/PDF/WhatsApp) -> normalized prices -> PDF quote + email, driven from WhatsApp",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.cli.json",
    "ingest": "tsx --tsconfig tsconfig.cli.json src/cli/ingest.ts",
    "quote": "tsx --tsconfig tsconfig.cli.json src/cli/quote.ts",
    "prices": "tsx --tsconfig tsconfig.cli.json src/cli/prices.ts",
    "wa:simulate": "tsx --tsconfig tsconfig.cli.json src/cli/wa-simulate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@react-pdf/renderer": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.1.0",
    "next": "^16.4.0",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.32.1",
    "unpdf": "^1.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
